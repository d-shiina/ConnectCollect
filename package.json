{
  "name": "rpa-tool",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted, sequential-execution RPA tool (MVP)",
  "license": "UNLICENSED",
  "workspaces": [
    "electron",
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,electron -c blue,green \"npm run dev -w @rpa-tool/frontend\" \"wait-on http://localhost:5173 && npm run dev:run -w @rpa-tool/electron\"",
    "dev:frontend": "npm run dev -w @rpa-tool/frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "agent:install": "cd agent && poetry install",
    "agent:test": "cd agent && poetry run pytest",
    "agent:lint": "cd agent && poetry run ruff check src tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
